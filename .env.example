# Copy to .env only if your host reads it; all values are optional.
PORT=8080
# 0 = Run Code only from localhost
C_RUNNER_PUBLIC=1
# Programs running at once, for all visitors together
C_RUNNER_MAX_CONCURRENT=3
# Runs per visitor IP per minute
C_RUNNER_RUNS_PER_MINUTE=10
# Wall-clock limit per run (seconds)
C_RUNNER_RUN_TIMEOUT_SEC=60
# Linux only: CPU seconds and memory per run
C_RUNNER_CPU_SEC=20
C_RUNNER_MEM_MB=512
# Set to 0 if the server is NOT behind a proxy / load balancer
TRUST_PROXY=1
